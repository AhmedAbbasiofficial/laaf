SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=your_public_storefront_token_here
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token_here
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id_here
SHOPIFY_CLIENT_SECRET=your_client_secret_here

# OAuth Configuration (for one-time offline access token setup)
# Set REDIRECT_URI to your deployed URL + /api/shopify/callback
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/shopify/callback
SHOPIFY_SCOPES=read_products,read_inventory,write_orders

# After running /api/shopify/install and completing OAuth,
# paste the offline access token here (from .data/shopify-token.json)
# SHOPIFY_OFFLINE_ACCESS_TOKEN=paste_token_here

# Judge.me (server-side only — NOT VITE_ prefixed)
JUDGEME_SHOP_DOMAIN=your-store.myshopify.com
JUDGEME_PRIVATE_API_TOKEN=your_judgeme_private_token
